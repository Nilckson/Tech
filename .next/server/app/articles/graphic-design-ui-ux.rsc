yle":{"fontSize":"0.72rem","color":"#6a8fa8","fontFamily":"'DM Sans', sans-serif"},"children":["Jun 5, 2026"," · ","6 min read"]}]]}],["$","h1",null,{"style":{"fontFamily":"'Syne', sans-serif","fontWeight":900,"fontSize":"clamp(1.8rem, 6vw, 2.5rem)","lineHeight":1.15,"letterSpacing":"-0.025em","color":"#e8f4ff","marginBottom":"1rem"},"children":"Graphic Design & UI/UX: Designing for the Digital Age"}],["$","p",null,{"style":{"fontSize":"1rem","color":"#3d5a6e","lineHeight":1.7,"fontFamily":"'DM Sans', sans-serif","fontWeight":300},"children":"Develop an eye for design. Learn digital branding, layout structuring, and modern user interface principles."}],["$","div",null,{"style":{"height":"1px","background":"linear-gradient(90deg, #f472b640, transparent)","margin":"2rem 0"}}]]}],["$","article",null,{"className":"prose","style":{"paddingBottom":"5rem"},"children":[["$","p","0",{"dangerouslySetInnerHTML":{"__html":"Design is not decoration. Good design solves problems, communicates clearly, and guides the user without them noticing."}}],["$","div","1",{"style":{"height":"0.5rem"}}],["$","h2","2",{"children":"The Difference Between Graphic Design and UI/UX"}],["$","div","3",{"style":{"height":"0.5rem"}}],["$","p","4",{"dangerouslySetInnerHTML":{"__html":"<strong>Graphic design</strong> focuses on visual communication — typography, color, imagery, and layout. It is about making things look intentional and beautiful."}}],["$","div","5",{"style":{"height":"0.5rem"}}],["$","p","6",{"dangerouslySetInnerHTML":{"__html":"<strong>UI design</strong> applies those principles to interfaces — buttons, forms, navigation, and screens."}}],["$","div","7",{"style":{"height":"0.5rem"}}],["$","p","8",{"dangerouslySetInnerHTML":{"__html":"<strong>UX design</strong> is about the full user experience — how intuitive is the flow? Where do users get confused? What does the journey feel like from start to finish?"}}],["$","div","9",{"style":{"height":"0.5rem"}}],["$","p","10",{"dangerouslySetInnerHTML":{"__html":"All three overlap. The best designers think in all three dimensions at once."}}],["$","div","11",{"style":{"height":"0.5rem"}}],["$","h2","12",{"children":"Core Design Principles"}],["$","div","13",{"style":{"height":"0.5rem"}}],["$","p","14",{"dangerouslySetInnerHTML":{"__html":"<strong>Hierarchy.</strong> Guide the eye. The most important element should be the most visually dominant — through size, weight, or color."}}],["$","div","15",{"style":{"height":"0.5rem"}}],["$","p","16",{"dangerouslySetInnerHTML":{"__html":"<strong>Contrast.</strong> Differences create interest and readability. High contrast between text and background is not optional — it is accessibility."}}],["$","div","17",{"style":{"height":"0.5rem"}}],["$","p","18",{"dangerouslySetInnerHTML":{"__html":"<strong>Alignment.</strong> Everything should feel intentionally placed. Invisible grids create order even when nothing looks rigid."}}],["$","div","19",{"style":{"height":"0.5rem"}}],["$","p","20",{"dangerouslySetInnerHTML":{"__html":"<strong>Whitespace.</strong> Empty space is not wasted space. It lets elements breathe and helps users focus on what matters."}}],["$","div","21",{"style":{"height":"0.5rem"}}],["$","p","22",{"dangerouslySetInnerHTML":{"__html":"<strong>Consistency.</strong> Repeating visual patterns — the same button style, the same spacing unit, the same font scale — builds trust and reduces cognitive load."}}],["$","div","23",{"style":{"height":"0.5rem"}}],["$","h2","24",{"children":"Typography Fundamentals"}],["$","div","25",{"style":{"height":"0.5rem"}}],["$","ul","26",{"children":["$","li",null,{"dangerouslySetInnerHTML":{"__html":"Pair a strong display font for headings with a readable body font"}}]}],["$","ul","27",{"children":["$","li",null,{"dangerouslySetInnerHTML":{"__html":"Limit yourself to two fonts per project — three at most"}}]}],["$","ul","28",{"children":["$","li",null,{"dangerouslySetInnerHTML":{"__html":"Use a type scale: base size, then multiply by 1.25 or 1.5 for each level up"}}]}],["$","ul","29",{"children":["$","li",null,{"dangerouslySetInnerHTML":{"__html":"Line height for body text should be 1.5 to 1.7 — never less than 1.4"}}]}],["$","ul","30",{"children":["$","li",null,{"dangerouslySetInnerHTML":{"__html":"Never use pure black on white — use dark grey like #1a1a2e for softer, more professional text"}}]}],["$","div","31",{"style":{"height":"0.5rem"}}],["$","h2","32",{"children":"Color Theory in Practice"}],["$","div","33",{"style":{"height":"0.5rem"}}],["$","ol","34",{"children":["$","li",null,{"dangerouslySetInnerHTML":{"__html":"Start with one primary brand color"}}]}],["$","ol","35",{"children":["$","li",null,{"dangerouslySetInnerHTML":{"__html":"Build a neutral palette — greys and off-whites for backgrounds and text"}}]}],["$","ol","36",{"children":["$","li",null,{"dangerouslySetInnerHTML":{"__html":"Add one or two accent colors for interactive elements and highlights"}}]}],["$","ol","37",{"children":["$","li",null,{"dangerouslySetInnerHTML":{"__html":"Check contrast ratios — WCAG AA requires at least 4.5:1 for normal text"}}]}],["$","ol","38",{"children":["$","li",null,{"dangerouslySetInnerHTML":{"__html":"Test your palette in both light and dark modes"}}]}],["$","div","39",{"style":{"height":"0.5rem"}}],["$","h2","40",{"children":"Tools to Learn"}],["$","div","41",{"style":{"height":"0.5rem"}}],["$","p","42",{"dangerouslySetInnerHTML":{"__html":"<strong>Figma</strong> — the industry standard for UI design and prototyping. Free for individuals."}}],["$","div","43",{"style":{"height":"0.5rem"}}],["$","p","44",{"dangerouslySetInnerHTML":{"__html":"<strong>Adobe Illustrator</strong> — vector graphics and logo design."}}],["$","div","45",{"style":{"height":"0.5rem"}}],["$","p","46",{"dangerouslySetInnerHTML":{"__html":"<strong>Adobe Photoshop</strong> — photo editing and raster graphics."}}],["$","div","47",{"style":{"height":"0.5rem"}}],["$","p","48",{"dangerouslySetInnerHTML":{"__html":"<strong>Coolors</strong> — fast color palette generation."}}],["$","div","49",{"style":{"height":"0.5rem"}}],["$","p","50",{"dangerouslySetInnerHTML":{"__html":"<strong>Google Fonts</strong> — free, high-quality typefaces for web projects."}}],["$","div","51",{"style":{"height":"0.5rem"}}],["$","h2","52",{"children":"Where to Start"}],["$","div","53",{"style":{"height":"0.5rem"}}],["$","ul","54",{"children":["$","li",null,{"dangerouslySetInnerHTML":{"__html":"Study interfaces you admire. Ask why they work — what is the hierarchy? What draws your eye first?"}}]}],["$","ul","55",{"children":["$","li",null,{"dangerouslySetInnerHTML":{"__html":"Redesign an existing app screen as a practice exercise"}}]}],["$","ul","56",{"children":["$","li",null,{"dangerouslySetInnerHTML":{"__html":"Build a small design system — define your colors, fonts, spacing, and component styles"}}]}],["$","ul","57",{"children":["$","li",null,{"dangerouslySetInnerHTML":{"__html":"Share your work. Feedback accelerates growth faster than anything else"}}]}]]}],["$","$L9",null,{}]]}]]}]]
